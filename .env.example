# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird NICHT committet.

# SEC EDGAR verlangt einen identifizierenden User-Agent: "Name email@example.com"
SEC_USER_AGENT=

# Pfad zur SQLite-Datei
DATABASE_PATH=data/research.db

# Begrenzung der KI-Nutzung (claude -p). Jeder erfolgreiche Aufruf zählt; bei Erreichen stoppt die KI-Arbeit
# mit einer klaren Meldung, Zahlen und Alerts laufen weiter. Anzeige: python -m invest_research usage
LLM_MAX_CALLS_PER_DAY=80
# Optional: monatliche Obergrenze nach Listenpreis in USD (bei Abo nur eine Orientierung), leer = keine
LLM_MAX_COST_USD_PER_MONTH=
